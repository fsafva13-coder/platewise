<odoo>
    <record id="platewise_food_category_action" model="ir.actions.act_window">
        <field name="name">Food Categories</field>
        <field name="res_model">platewise.food.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="platewise_food_category_view_list" model="ir.ui.view">
        <field name="name">platewise.food.category.list</field>
        <field name="model">platewise.food.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="co2_factor"/>
            </list>
        </field>
    </record>
</odoo>
